{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 3650,
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-5-5",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "claude-opus-5-5",
  "enforceAvailableModels": true,
  "enableAllProjectMcpServers": false,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/aicodemetricsd",
            "args": ["hook", "claude", "--hook-input", "stdin"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/aicodemetricsd",
            "args": ["hook", "claude", "--hook-input", "stdin"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/aicodemetricsd",
            "args": ["hook", "claude", "--hook-input", "stdin"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/aicodemetricsd",
            "args": ["hook", "claude", "--hook-input", "stdin"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/aicodemetricsd",
            "args": ["hook", "claude", "--hook-input", "stdin"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/aicodemetricsd",
            "args": ["hook", "claude", "--hook-input", "stdin"],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/aicodemetricsd",
            "args": ["hook", "claude", "--hook-input", "stdin"],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "workflowSizeGuideline": "unrestricted",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 1
  },
  "enabledPlugins": {
    "nomad@zerofox-claude-plugins": true,
    "linear@zerofox-claude-plugins": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "zerofox-claude-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/riskive/ai-tooling.git"
      }
    }
  },
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": ["*"]
    },
    "filesystem": {
      "allowWrite": ["."]
    }
  },
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "skipWorkflowUsageWarning": true,
  "teammateMode": "tmux",
  "skipAutoPermissionPrompt": true,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  }
}
