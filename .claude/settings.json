{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "attribution": {
        "commit": "",
        "pr": ""
    },
    "autoDreamEnabled": false,
    "autoMemoryEnabled": false,
    "autoUpdatesChannel": "stable",
    "cleanupPeriodDays": 3650,
    "effortLevel": "high",
    "enableAllProjectMcpServers": false,
    "enabledPlugins": {
        "nomad@zerofox-claude-plugins": true
    },
    "enforceAvailableModels": true,
    "env": {
        "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
        "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-5-5",
        "DISABLE_ERROR_REPORTING": "1",
        "DISABLE_TELEMETRY": "1"
    },
    "extraKnownMarketplaces": {
        "openai-codex": {
            "source": {
                "repo": "openai/codex-plugin-cc",
                "source": "github"
            }
        },
        "zerofox-claude-plugins": {
            "source": {
                "source": "git",
                "url": "https://github.com/riskive/ai-tooling.git"
            }
        }
    },
    "hooks": {
        "PostToolUse": [
            {
                "hooks": [
                    {
                        "args": ["hook", "claude", "--hook-input", "stdin"],
                        "command": "/usr/local/bin/aicodemetricsd",
                        "timeout": 10,
                        "type": "command"
                    }
                ],
                "matcher": "*"
            }
        ],
        "PostToolUseFailure": [
            {
                "hooks": [
                    {
                        "args": ["hook", "claude", "--hook-input", "stdin"],
                        "command": "/usr/local/bin/aicodemetricsd",
                        "timeout": 10,
                        "type": "command"
                    }
                ],
                "matcher": "*"
            }
        ],
        "PreCompact": [
            {
                "hooks": [
                    {
                        "args": ["hook", "claude", "--hook-input", "stdin"],
                        "command": "/usr/local/bin/aicodemetricsd",
                        "timeout": 10,
                        "type": "command"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "hooks": [
                    {
                        "args": ["hook", "claude", "--hook-input", "stdin"],
                        "command": "/usr/local/bin/aicodemetricsd",
                        "timeout": 10,
                        "type": "command"
                    }
                ],
                "matcher": "*"
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "args": ["hook", "claude", "--hook-input", "stdin"],
                        "command": "/usr/local/bin/aicodemetricsd",
                        "timeout": 10,
                        "type": "command"
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "args": ["hook", "claude", "--hook-input", "stdin"],
                        "command": "/usr/local/bin/aicodemetricsd",
                        "timeout": 10,
                        "type": "command"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "args": ["hook", "claude", "--hook-input", "stdin"],
                        "command": "/usr/local/bin/aicodemetricsd",
                        "timeout": 10,
                        "type": "command"
                    }
                ]
            }
        ]
    },
    "model": "claude-opus-5-5",
    "permissions": {
        "defaultMode": "auto"
    },
    "sandbox": {
        "autoAllowBashIfSandboxed": true,
        "enabled": false,
        "filesystem": {
            "allowWrite": ["."]
        },
        "network": {
            "allowedDomains": ["*"]
        }
    },
    "skipAutoPermissionPrompt": true,
    "skipWorkflowUsageWarning": true,
    "spinnerTipsEnabled": false,
    "statusLine": {
        "command": "~/.claude/statusline.sh",
        "padding": 1,
        "type": "command"
    },
    "teammateMode": "tmux",
    "tui": "fullscreen",
    "workflowSizeGuideline": "unrestricted"
}
