+# ASCII BOAT SHELL INTEGRATION END boat
+
 # source exports
 source ~/.zsh_exports
 
@@ -6,6 +14,7 @@ export PATH="/opt/homebrew/opt/python@3/libexec/bin:$PATH"              # for py
 export PATH="/opt/homebrew/opt/gnu-sed/libexec/gnubin:$PATH"            # for gnu-sed
