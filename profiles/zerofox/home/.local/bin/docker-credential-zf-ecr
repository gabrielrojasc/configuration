#!/bin/sh
# Docker credential helper for ZF's ECR registry, so docker commands (agents'
# included) authenticate without a manual `vt aws ecr-login`.
# vt reuses its cached Vault token and AWS keys, or opens the browser for Okta
# when they expire. The AWS helper turns the keys into a cached 12h ECR token.
set -u
export AWS_PROFILE=aws-ecr-ro
ecr_helper=/opt/homebrew/bin/docker-credential-ecr-login

# store/erase/list come from `docker login`/`logout`; nothing to refresh.
[ "${1:-}" = get ] || exec "$ecr_helper" "$@"

server=$(cat)

# Serialize vt so parallel builds share one Okta tab and one set of keys.
# vt prints to stdout, which Docker reads as the credential JSON.
mkdir -p "$HOME/.ecr"
/usr/bin/lockf -k "$HOME/.ecr/zf-ecr.lock" \
  /usr/local/bin/vt aws login -r aws-ecr-ro </dev/null 1>&2 || exit 1

# After an expiry Vault mints a new IAM user, which AWS rejects for ~15s.
i=0
while [ "$i" -lt 30 ]; do
  if out=$(printf '%s' "$server" | "$ecr_helper" get 2>/dev/null); then
    printf '%s\n' "$out"
    exit 0
  fi
  i=$((i + 1))
  sleep 1
done
printf '%s' "$server" | exec "$ecr_helper" get
